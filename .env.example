# Domain, die auf den VPS zeigt (A-Record). Caddy holt dafür automatisch ein Let's-Encrypt-Zertifikat.
DOMAIN=ticker.example.com
# Zugriffstoken für alle API-Anfragen: openssl rand -hex 32
API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CACHE_TTL_MINUTES=20
RATE_LIMIT_PER_MINUTE=30
# Kostenbremse: maximale LLM-Aufrufe pro Tag
LLM_MAX_CALLS_PER_DAY=300
# Meldungen älter als X Stunden werden verworfen
MAX_AGE_HOURS=48
TZ=Europe/Berlin
# Artikel schon beim Listenabruf holen und mitzusammenfassen (1 = ja, 0 = erst bei "Mehr")
PREFETCH_DETAILS=1
